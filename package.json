{
  "name": "rulebearing-repo",
  "private": true,
  "type": "module",
  "description": "Tooling root for the TypeScript packages. The published package is wrappers/npm (docs/architecture.md#distribution).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-links": "cargo xtask check-links",
    "lint:all": "cargo xtask lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.1"
  }
}
