<!--
  Shared package metadata for every C# project Rulebearing publishes to NuGet: the `Rulebearing`
  dotnet tool (wrappers/nuget) and the Rulebearing.TestAdapter packages (adapters/dotnet).
  Imported by the Directory.Build.props of those two trees, after the root one.

  Version: the release version is the workspace version in Cargo.toml (docs/release.md, "The
  workspace version in Cargo.toml is the release version"), read here so the source tree carries
  one version and is never edited to release. `dotnet pack -p:Version=<version>` overrides it, as
  the release workflow's staging step does for the npm packages.
  Decisions: docs/adr/0020-single-name-across-registries.md (one name, one version),
  docs/adr/0019-mit-licence.md (MIT). Plan: docs/plans/pending/0002-wave-2-dotnet-python-element-rules.md,
  Step 14 (2H).
-->
<Project>
  <PropertyGroup>
    <RulebearingCargoToml>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'Cargo.toml'))</RulebearingCargoToml>
    <RulebearingWorkspaceVersion Condition="Exists('$(RulebearingCargoToml)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RulebearingCargoToml)')), '(?&lt;=\[workspace\.package\]\s+version\s*=\s*")[^"]+').Value)</RulebearingWorkspaceVersion>
    <RulebearingVersionGiven Condition="'$(Version)' != ''">true</RulebearingVersionGiven>
    <Version Condition="'$(Version)' == ''">$(RulebearingWorkspaceVersion)</Version>
    <Authors>Ben Bahrenburg</Authors>
    <Copyright>Copyright (c) Ben Bahrenburg</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/benbahrenburg/rulebearing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/benbahrenburg/rulebearing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>architecture;rules;dependency-cruiser;archunit;import-linter;guardrails</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- A pack without a version would publish 1.0.0; refuse instead. -->
  <Target Name="RulebearingRequireVersion" BeforeTargets="GenerateNuspec;Build">
    <Error Condition="'$(RulebearingVersionGiven)' != 'true' and '$(RulebearingWorkspaceVersion)' == ''" Text="No package version: Cargo.toml has no [workspace.package] version and no -p:Version was given (docs/release.md)." />
  </Target>
</Project>
