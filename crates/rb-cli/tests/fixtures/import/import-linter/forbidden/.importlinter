[importlinter]
root_package = shop

[importlinter:contract:no-payments]
name = Orders do not reach payments
type = forbidden
source_modules =
    shop.orders
forbidden_modules =
    shop.payments
    requests
ignore_imports =
    shop.orders.checkout -> shop.payments.gateway
    shop.orders.* -> shop.nowhere
unmatched_ignore_imports_alerting = none

[importlinter:contract:models-direct]
name = No module imports another package's models directly
type = forbidden
source_modules =
    shop.*.views
forbidden_modules =
    shop.**.models
allow_indirect_imports = true
as_packages = False
