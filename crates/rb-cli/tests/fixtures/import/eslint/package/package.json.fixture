{
    "name": "example",
    "eslintConfig": {
        "rules": {
            "import/no-restricted-paths": [
                "error",
                { "zones": [{ "target": "./packages/a", "from": "./packages/b" }] }
            ],
            "boundaries/element-types": ["error", { "default": "allow", "rules": [{ "from": "b", "disallow": "a" }] }]
        },
        "settings": {
            "boundaries/elements": [
                { "type": "a", "pattern": "packages/a", "mode": "full" },
                { "type": "b", "pattern": "packages/b/**", "basePattern": "src" }
            ]
        }
    }
}
