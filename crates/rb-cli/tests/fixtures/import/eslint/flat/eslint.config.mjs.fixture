// A flat configuration: plugins imported from packages, which the importer never runs.
import path from 'node:path';
import js from '@eslint/js';
import tseslint from 'typescript-eslint';
import importPlugin from 'eslint-plugin-import';
import boundaries from 'eslint-plugin-boundaries';
import * as globals from 'globals';

const root = import.meta.dirname;

export default tseslint.config(
    js.configs.recommended,
    ...tseslint.configs.strictTypeChecked,
    {
        files: ['src/**/*.ts'],
        languageOptions: { globals: { ...globals.browser } },
        plugins: { import: importPlugin, boundaries },
        settings: {
            'boundaries/elements': [
                { type: 'app', pattern: 'src/app/*' },
                { type: 'feature', pattern: 'src/features/*' },
                { type: 'shared', pattern: 'src/shared/*' },
                { type: 'helper', pattern: 'src/helpers/*.ts', mode: 'file' },
            ],
        },
        rules: {
            'import/no-restricted-paths': [
                'error',
                {
                    basePath: path.resolve(root),
                    zones: [
                        {
                            target: './src/client',
                            from: './src/server',
                            except: ['./shared'],
                            message: 'The client runs in the browser.',
                        },
                        { target: ['./src/features', './src/shared'], from: './src/app' },
                        { target: './src/**/*.ts', from: './scripts/**' },
                    ],
                },
            ],
            'boundaries/element-types': [
                2,
                {
                    default: 'disallow',
                    rules: [
                        { from: 'app', allow: ['feature', 'shared', 'helper'] },
                        { from: 'feature', allow: ['shared', 'helper'] },
                        { from: ['shared', 'helper'], allow: 'helper' },
                    ],
                },
            ],
            'boundaries/no-unknown': 'error',
            'no-console': 'off',
        },
    },
    { files: ['**/*.test.ts'], rules: { 'import/no-restricted-paths': 'off' } },
);
