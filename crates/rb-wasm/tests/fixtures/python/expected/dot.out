strict digraph "dependency-cruiser output"{
    rankdir="LR" splines="true" overlap="false" nodesep="0.16" ranksep="0.18" fontname="Helvetica-bold" fontsize="9" style="rounded,bold,filled" fillcolor="#ffffff" compound="true"
    node [shape="box" style="rounded, filled" height="0.2" color="black" fillcolor="#ffffcc" fontcolor="black" fontname="Helvetica" fontsize="9"]
    edge [arrowhead="normal" arrowsize="0.6" penwidth="2.0" color="#00000033" fontname="Helvetica" fontsize="9"]

    "importlib" [label=<importlib> tooltip="importlib" URL="importlib" color="grey" fontcolor="grey"]
    "missing_package" [label=<missing_package> tooltip="missing_package" ]
    "os" [label=<os> tooltip="os" URL="os" color="grey" fontcolor="grey"]
    "requests" [label=<requests> tooltip="requests" URL="requests" ]
    subgraph "cluster_src" {label="src" subgraph "cluster_src/shop" {label="shop" "src/shop/__init__.py" [label=<__init__.py> tooltip="__init__.py" URL="src/shop/__init__.py" fillcolor="#ccffcc"] } }
    subgraph "cluster_src" {label="src" subgraph "cluster_src/shop" {label="shop" "src/shop/main.py" [label=<main.py> tooltip="main.py" URL="src/shop/main.py" ] } }
    "src/shop/main.py" -> "os"
    "src/shop/main.py" -> "requests"
    "src/shop/main.py" -> "src/shop/models.py" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" fontcolor="red" color="red"]
    "src/shop/main.py" -> "src/shop/ui/view.py" [arrowhead="normalnoneodot" penwidth="1.0"]
    "src/shop/main.py" -> "src/shop/util.py" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" fontcolor="red" color="red"]
    "src/shop/main.py" -> "typing"
    subgraph "cluster_src" {label="src" subgraph "cluster_src/shop" {label="shop" "src/shop/models.py" [label=<models.py> tooltip="models.py" URL="src/shop/models.py" ] } }
    "src/shop/models.py" -> "src/shop/main.py" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" fontcolor="red" color="red"]
    subgraph "cluster_src" {label="src" subgraph "cluster_src/shop" {label="shop" subgraph "cluster_src/shop/ui" {label="ui" "src/shop/ui/__init__.py" [label=<__init__.py> tooltip="__init__.py" URL="src/shop/ui/__init__.py" fillcolor="#ccffcc"] } } }
    subgraph "cluster_src" {label="src" subgraph "cluster_src/shop" {label="shop" subgraph "cluster_src/shop/ui" {label="ui" "src/shop/ui/view.py" [label=<view.py> tooltip="view.py" URL="src/shop/ui/view.py" ] } } }
    "src/shop/ui/view.py" -> "missing_package" [xlabel="no-unresolved" tooltip="no-unresolved" fontcolor="red" color="red"]
    "src/shop/ui/view.py" -> "src/shop/models.py" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" fontcolor="red" color="red"]
    subgraph "cluster_src" {label="src" subgraph "cluster_src/shop" {label="shop" "src/shop/util.py" [label=<util.py> tooltip="util.py" URL="src/shop/util.py" ] } }
    "src/shop/util.py" -> "importlib"
    "src/shop/util.py" -> "src/shop/models.py" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" style="dashed" fontcolor="red" color="red"]
    "typing" [label=<typing> tooltip="typing" URL="typing" color="grey" fontcolor="grey"]
}
