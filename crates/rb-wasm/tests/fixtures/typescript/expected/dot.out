    subgraph "cluster_src" {label="src" "src/index.ts" [label=<index.ts> tooltip="index.ts" URL="src/index.ts" fillcolor="#ddfeff"] }
    "src/index.ts" -> "./not-there" [xlabel="no-unresolvable" tooltip="no-unresolvable" fontcolor="red" color="red"]
    "src/index.ts" -> "src/order/order.ts"
    "src/index.ts" -> "src/util/format.ts"
    "src/index.ts" -> "fs" [style="dashed" penwidth="1.0"]
    "src/index.ts" -> "node_modules/lodash/index.js" [penwidth="1.0"]
    subgraph "cluster_src" {label="src" "src/legacy.js" [label=<legacy.js> tooltip="legacy.js" URL="src/legacy.js" ] }
    "src/legacy.js" -> "src/util/format.ts"
    "src/legacy.js" -> "left-pad" [xlabel="no-unresolvable" tooltip="no-unresolvable" fontcolor="red" color="red"]
    subgraph "cluster_src" {label="src" subgraph "cluster_src/order" {label="order" "src/order/discount.ts" [label=<discount.ts> tooltip="discount.ts" URL="src/order/discount.ts" fillcolor="#ddfeff"] } }
    "src/order/discount.ts" -> "src/order/order.ts" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" fontcolor="red" color="red"]
    subgraph "cluster_src" {label="src" subgraph "cluster_src/order" {label="order" "src/order/order.ts" [label=<order.ts> tooltip="order.ts" URL="src/order/order.ts" fillcolor="#ddfeff"] } }
    "src/order/order.ts" -> "src/order/discount.ts" [xlabel="no-circular" tooltip="no-circular" arrowhead="normalnoneodot" fontcolor="red" color="red"]
