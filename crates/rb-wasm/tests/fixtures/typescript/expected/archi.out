strict digraph "dependency-cruiser output"{
    rankdir="LR" splines="true" overlap="false" nodesep="0.16" ranksep="0.18" fontname="Helvetica-bold" fontsize="9" style="rounded,bold,filled" fillcolor="#ffffff" compound="true"
    node [shape="box" style="rounded, filled" height="0.2" color="black" fillcolor="#ffffcc" fontcolor="black" fontname="Helvetica" fontsize="9"]
    edge [arrowhead="normal" arrowsize="0.6" penwidth="2.0" color="#00000033" fontname="Helvetica" fontsize="9"]

    "./not-there" [label=<not-there> tooltip="not-there" ]
    "fs" [label=<fs> tooltip="fs" URL="https://nodejs.org/api/fs.html" color="grey" fontcolor="grey"]
    "left-pad" [label=<left-pad> tooltip="left-pad" ]
    subgraph "cluster_node_modules" {label="node_modules" "node_modules/lodash" [label=<lodash> tooltip="lodash" URL="node_modules/lodash" fillcolor="#c40b0a1a" fontcolor="#c40b0a" shape="box3d"] }
    subgraph "cluster_src" {label="src" "src/index.ts" [label=<index.ts> tooltip="index.ts" URL="src/index.ts" fillcolor="#ddfeff"] }
    "src/index.ts" -> "./not-there" [xlabel="no-unresolvable" tooltip="no-unresolvable" fontcolor="red" color="red"]
    "src/index.ts" -> "src/order"
    "src/index.ts" -> "src/util"
    "src/index.ts" -> "fs" [style="dashed" penwidth="1.0"]
    "src/index.ts" -> "node_modules/lodash" [penwidth="1.0"]
    subgraph "cluster_src" {label="src" "src/legacy.js" [label=<legacy.js> tooltip="legacy.js" URL="src/legacy.js" ] }
    "src/legacy.js" -> "src/util"
    "src/legacy.js" -> "left-pad" [xlabel="no-unresolvable" tooltip="no-unresolvable" fontcolor="red" color="red"]
    subgraph "cluster_src" {label="src" "src/order" [label=<order> tooltip="order" URL="src/order" shape="box3d"] }
    subgraph "cluster_src" {label="src" "src/ui" [label=<ui> tooltip="ui" URL="src/ui" fillcolor="#ccffcc" shape="box3d"] }
    subgraph "cluster_src" {label="src" "src/util" [label=<util> tooltip="util" URL="src/util" shape="box3d"] }
}
