{
  "$id": "https://benbahrenburg.github.io/rulebearing/schema/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AttributeElement": {
      "description": "An attribute or decorator applied to a type or member.",
      "properties": {
        "arguments": {
          "description": "Constructor and named arguments, as literal text.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attributeType": {
          "description": "The attribute type's full name.",
          "type": "string"
        },
        "column": {
          "description": "1-based column.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "description": "Repository-relative path, absent when attribution failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "allOf": [
            {
              "$ref": "#/definitions/Language"
            }
          ],
          "description": "The language the element came from."
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "target": {
          "description": "The full name of the type or `Type.member` it is applied to.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "attributeType",
        "language"
      ],
      "type": "object"
    },
    "Attribution": {
      "enum": [
        "pdb",
        "inferred",
        "none"
      ],
      "type": "string"
    },
    "CallElement": {
      "description": "A call from one member to another.",
      "properties": {
        "column": {
          "description": "1-based column.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "description": "Repository-relative path, absent when attribution failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "description": "The calling member, `Type.member`.",
          "type": "string"
        },
        "language": {
          "allOf": [
            {
              "$ref": "#/definitions/Language"
            }
          ],
          "description": "The language the element came from."
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "description": "The called member, `Type.member`.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "language"
      ],
      "type": "object"
    },
    "Change": {
      "additionalProperties": true,
      "description": "One entry in [`RevisionData::changes`]. Extra keys are kept, as upstream allows them.",
      "properties": {
        "args": {
          "description": "The command-line arguments of the cached run.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "checksum": {
          "description": "Content checksum.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The file.",
          "type": "string"
        },
        "oldName": {
          "description": "The previous name, for a rename.",
          "type": [
            "string",
            "null"
          ]
        },
        "rulesFile": {
          "description": "The rules file of the cached run.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/definitions/ChangeType"
            }
          ],
          "description": "What happened to it."
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "ChangeType": {
      "enum": [
        "added",
        "copied",
        "deleted",
        "modified",
        "renamed",
        "type changed",
        "unmerged",
        "pairing broken",
        "unknown",
        "unmodified",
        "untracked",
        "ignored"
      ],
      "type": "string"
    },
    "CodeLayer": {
      "additionalProperties": false,
      "description": "`code`: the four element lists.",
      "properties": {
        "attributes": {
          "default": [],
          "description": "Attributes and decorators applied to a type or member.",
          "items": {
            "$ref": "#/definitions/AttributeElement"
          },
          "type": "array"
        },
        "calls": {
          "default": [],
          "description": "Call edges between members.",
          "items": {
            "$ref": "#/definitions/CallElement"
          },
          "type": "array"
        },
        "members": {
          "default": [],
          "description": "Methods, constructors, properties, fields, events and accessors.",
          "items": {
            "$ref": "#/definitions/MemberElement"
          },
          "type": "array"
        },
        "types": {
          "default": [],
          "description": "Classes, interfaces, enums, structs, records, delegates, type aliases, functions.",
          "items": {
            "$ref": "#/definitions/TypeElement"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "description": "One edge in the module layer: `modules[].dependencies[]`.",
      "properties": {
        "circular": {
          "description": "Whether following the edge returns to the source.",
          "type": "boolean"
        },
        "column": {
          "description": "Additive: 1-based column of the import or reference.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "coreModule": {
          "description": "Whether the target is a runtime built-in.",
          "type": "boolean"
        },
        "couldNotResolve": {
          "description": "Whether the specifier could not be resolved.",
          "type": "boolean"
        },
        "cycle": {
          "description": "One cycle through the edge, when `circular`.",
          "items": {
            "$ref": "#/definitions/MiniDependency"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "declared": {
          "description": "Additive: the edge was declared rather than detected (wave 4).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "dependencyKind": {
          "anyOf": [
            {
              "$ref": "#/definitions/DependencyKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Additive: what kind of reference formed the edge."
        },
        "dependencyTypes": {
          "description": "The dependency types of the edge.",
          "items": {
            "$ref": "#/definitions/DependencyType"
          },
          "type": "array"
        },
        "dynamic": {
          "description": "Whether the edge is `import()`.",
          "type": "boolean"
        },
        "exoticRequire": {
          "description": "The exotic require name used.",
          "type": [
            "string",
            "null"
          ]
        },
        "exoticallyRequired": {
          "description": "Whether the edge came through an exotic require name.",
          "type": "boolean"
        },
        "followable": {
          "description": "Whether the extractor follows the edge.",
          "type": "boolean"
        },
        "instability": {
          "description": "The target's instability, denormalised.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "license": {
          "description": "The target's npm licence.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "Additive: 1-based line of the import or reference.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "matchesDoNotFollow": {
          "description": "Whether the target matched `doNotFollow`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "member": {
          "description": "Additive: the member reference that formed the edge.",
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "description": "The MIME type of a `data:` specifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "description": "The specifier as written (`./x`, `lodash`), without its protocol.",
          "type": "string"
        },
        "moduleSystem": {
          "allOf": [
            {
              "$ref": "#/definitions/ModuleSystem"
            }
          ],
          "description": "The module system of the dependency form."
        },
        "preCompilationOnly": {
          "description": "Whether the edge disappears after TypeScript compilation.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/definitions/Protocol"
            },
            {
              "type": "null"
            }
          ],
          "description": "The protocol stripped from the specifier."
        },
        "resolved": {
          "description": "The resolved, base-relative path, or the specifier when unresolved.",
          "type": "string"
        },
        "rules": {
          "description": "Rules the edge violated.",
          "items": {
            "$ref": "#/definitions/RuleSummary"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sidecar": {
          "description": "Additive: the edge came from the Node sidecar\n([ADR-0017](../../../docs/adr/0017-coffeescript-livescript-sidecar.md)).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "typeOnly": {
          "description": "Whether only types cross the edge.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "valid": {
          "description": "`true` when no rule flagged the edge.",
          "type": "boolean"
        }
      },
      "required": [
        "module",
        "resolved",
        "coreModule",
        "dependencyTypes",
        "followable",
        "dynamic",
        "exoticallyRequired",
        "couldNotResolve",
        "circular",
        "moduleSystem",
        "valid"
      ],
      "type": "object"
    },
    "DependencyKind": {
      "enum": [
        "import",
        "inherits",
        "implements",
        "field",
        "signature",
        "body",
        "attribute",
        "generic-argument",
        "typeof",
        "call"
      ],
      "type": "string"
    },
    "DependencyType": {
      "enum": [
        "aliased-subpath-import",
        "aliased-tsconfig-base-url",
        "aliased-tsconfig-paths",
        "aliased-tsconfig",
        "aliased-webpack",
        "aliased-workspace",
        "aliased",
        "amd-define",
        "amd-require",
        "amd-exotic-require",
        "core",
        "deprecated",
        "dynamic-import",
        "exotic-require",
        "export",
        "import-equals",
        "import",
        "jsdoc",
        "jsdoc-bracket-import",
        "jsdoc-import-tag",
        "local",
        "localmodule",
        "npm-bundled",
        "npm-dev",
        "npm-no-pkg",
        "npm-optional",
        "npm-peer",
        "npm-unknown",
        "npm",
        "pre-compilation-only",
        "process-get-builtin-module",
        "require",
        "triple-slash-amd-dependency",
        "triple-slash-directive",
        "triple-slash-file-reference",
        "triple-slash-type-reference",
        "type-import",
        "type-only",
        "undetermined",
        "unknown",
        "project",
        "package",
        "framework",
        "test-only",
        "signature-only",
        "unresolved",
        "stdlib",
        "site",
        "dynamic"
      ],
      "type": "string"
    },
    "Environment": {
      "additionalProperties": false,
      "description": "`summary.environment`.",
      "properties": {
        "extensionsFound": {
          "description": "Extensions and whether each was scannable.",
          "items": {
            "$ref": "#/definitions/ExtensionFound"
          },
          "type": "array"
        },
        "issues": {
          "description": "Problems that may have influenced the cruise.",
          "items": {
            "$ref": "#/definitions/EnvironmentIssue"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "nodeVersionFound": {
          "description": "The runtime found.",
          "type": "string"
        },
        "nodeVersionSupported": {
          "description": "The runtime range supported.",
          "type": "string"
        },
        "osVersionFound": {
          "description": "The operating system found.",
          "type": "string"
        },
        "transpilersFound": {
          "description": "Transpilers and whether each was available.",
          "items": {
            "$ref": "#/definitions/TranspilerFound"
          },
          "type": "array"
        },
        "version": {
          "description": "The tool version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "nodeVersionSupported",
        "nodeVersionFound",
        "osVersionFound",
        "transpilersFound",
        "extensionsFound"
      ],
      "type": "object"
    },
    "EnvironmentIssue": {
      "additionalProperties": false,
      "description": "One issue in [`Environment`].",
      "properties": {
        "description": {
          "description": "What happened.",
          "type": "string"
        },
        "name": {
          "description": "A short name.",
          "type": "string"
        },
        "severity": {
          "allOf": [
            {
              "$ref": "#/definitions/Severity"
            }
          ],
          "description": "How much it matters."
        }
      },
      "required": [
        "severity",
        "name",
        "description"
      ],
      "type": "object"
    },
    "ExperimentalStats": {
      "additionalProperties": false,
      "description": "`experimentalStats` on a module or folder.",
      "properties": {
        "size": {
          "description": "Size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "topLevelStatementCount": {
          "description": "Top-level statements in the file.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "topLevelStatementCount",
        "size"
      ],
      "type": "object"
    },
    "ExtensionFound": {
      "additionalProperties": false,
      "description": "One extension in [`Environment`].",
      "properties": {
        "available": {
          "description": "Whether it could be scanned.",
          "type": "boolean"
        },
        "extension": {
          "description": "The extension, with its dot.",
          "type": "string"
        }
      },
      "required": [
        "extension",
        "available"
      ],
      "type": "object"
    },
    "Folder": {
      "additionalProperties": false,
      "description": "One node in the folder layer: `folders[]`.",
      "properties": {
        "afferentCouplings": {
          "description": "Modules outside that depend on modules inside.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "dependencies": {
          "description": "Folders this one depends on.",
          "items": {
            "$ref": "#/definitions/FolderDependency"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "dependents": {
          "description": "Folders that depend on this one.",
          "items": {
            "$ref": "#/definitions/FolderDependent"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "efferentCouplings": {
          "description": "Modules inside that depend on modules outside.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "experimentalStats": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExperimentalStats"
            },
            {
              "type": "null"
            }
          ],
          "description": "Summed statistics, when `experimentalStats` is on."
        },
        "instability": {
          "description": "Efferent over total coupling.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "moduleCount": {
          "description": "Modules in the folder and its sub-folders. Signed because the upstream schema types it\nas a plain number and dependency-cruiser's metrics use `-1` for \"not counted\".",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "description": "Posix folder name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "moduleCount"
      ],
      "type": "object"
    },
    "FolderDependency": {
      "additionalProperties": false,
      "description": "A folder a [`Folder`] depends on.",
      "properties": {
        "circular": {
          "description": "Whether following the edge returns to the folder.",
          "type": "boolean"
        },
        "cycle": {
          "description": "One cycle through the edge.",
          "items": {
            "$ref": "#/definitions/MiniDependency"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "instability": {
          "description": "Its instability, denormalised.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "description": "The folder depended on.",
          "type": "string"
        },
        "rules": {
          "description": "Rules the edge violated.",
          "items": {
            "$ref": "#/definitions/RuleSummary"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "valid": {
          "description": "`true` when no rule flagged the edge.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "valid",
        "circular"
      ],
      "type": "object"
    },
    "FolderDependent": {
      "additionalProperties": false,
      "description": "A folder that depends on a [`Folder`].",
      "properties": {
        "name": {
          "description": "The dependent folder.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "InstabilityMetric": {
      "additionalProperties": false,
      "description": "One instability figure.",
      "properties": {
        "instability": {
          "description": "Efferent over total coupling.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "instability"
      ],
      "type": "object"
    },
    "Language": {
      "enum": [
        "typescript",
        "javascript",
        "dotnet",
        "python"
      ],
      "type": "string"
    },
    "MemberElement": {
      "description": "One member of a type.",
      "properties": {
        "abstract": {
          "description": "Abstract.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "column": {
          "description": "1-based column.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "declaringType": {
          "description": "The declaring type's full name.",
          "type": "string"
        },
        "file": {
          "description": "Repository-relative path, absent when attribution failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`method`, `constructor`, `property`, `field`, `event`, `getter`, `setter`.",
          "type": "string"
        },
        "language": {
          "allOf": [
            {
              "$ref": "#/definitions/Language"
            }
          ],
          "description": "The language the element came from."
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Simple name.",
          "type": "string"
        },
        "parameterTypes": {
          "description": "Parameter types' full names, in order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readonly": {
          "description": "Read-only (a field) or get-only (a property).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "returnType": {
          "description": "The return or field type's full name.",
          "type": [
            "string",
            "null"
          ]
        },
        "static": {
          "description": "Static.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "virtual": {
          "description": "Virtual or overridable.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "visibility": {
          "description": "Visibility, as for [`TypeElement::visibility`].",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "declaringType",
        "name",
        "kind",
        "language"
      ],
      "type": "object"
    },
    "MiniDependency": {
      "additionalProperties": false,
      "description": "One step of a cycle or a `via` chain.",
      "properties": {
        "dependencyTypes": {
          "description": "The dependency types of the step.",
          "items": {
            "$ref": "#/definitions/DependencyType"
          },
          "type": "array"
        },
        "name": {
          "description": "The module name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "dependencyTypes"
      ],
      "type": "object"
    },
    "Module": {
      "additionalProperties": false,
      "description": "One node in the module layer: `modules[]`.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "$ref": "#/definitions/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Additive: how a .NET module was attributed to a file\n([ADR-0011](../../../docs/adr/0011-read-dotnet-assemblies-not-source.md))."
        },
        "checksum": {
          "description": "Content checksum, for the cache.",
          "type": [
            "string",
            "null"
          ]
        },
        "consolidated": {
          "description": "Whether the module stands for a collapsed folder.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "coreModule": {
          "description": "Whether the module is a runtime built-in.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "couldNotResolve": {
          "description": "Whether the module could not be resolved.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "dependencies": {
          "description": "Outgoing edges.",
          "items": {
            "$ref": "#/definitions/Dependency"
          },
          "type": "array"
        },
        "dependencyTypes": {
          "description": "The dependency types of the edges that lead to this module.",
          "items": {
            "$ref": "#/definitions/DependencyType"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "dependents": {
          "description": "The resolved names of the modules that depend on this one.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "experimentalStats": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExperimentalStats"
            },
            {
              "type": "null"
            }
          ],
          "description": "Size and statement counts, when `experimentalStats` is on."
        },
        "followable": {
          "description": "Whether the module was followed.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "instability": {
          "description": "Efferent over total coupling.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/definitions/Language"
            },
            {
              "type": "null"
            }
          ],
          "description": "Additive: which extractor produced the module."
        },
        "license": {
          "description": "The npm licence, when `resolveLicenses` found one.",
          "type": [
            "string",
            "null"
          ]
        },
        "matchesDoNotFollow": {
          "description": "Whether the module matched `doNotFollow`.",
          "type": [
