@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

HIDE_STEREOTYPE()

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Container(ArchUnitNETTests.ArchitectureTests, ArchitectureTests)
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Container(ArchUnitNETTests.AssemblyTestHelper, AssemblyTestHelper)
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Container(ArchUnitNETTests.Dependencies, Dependencies)
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Domain, Domain)  {
Boundary(Dependencies, Dependencies)  {
Container(ArchUnitNETTests.Domain.Dependencies.Attributes, Attributes)
}
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Domain, Domain)  {
Boundary(Dependencies, Dependencies)  {
Container(ArchUnitNETTests.Domain.Dependencies.Members, Members)
}
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Domain, Domain)  {
Boundary(Dependencies, Dependencies)  {
Container(ArchUnitNETTests.Domain.Dependencies.Types, Types)
}
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Domain, Domain)  {
Container(ArchUnitNETTests.Domain.Extensions, Extensions)
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Domain, Domain)  {
Container(ArchUnitNETTests.Domain.PlantUml, PlantUml)
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Fluent, Fluent)  {
Container(ArchUnitNETTests.Fluent.Extensions, Extensions)
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Fluent, Fluent)  {
Container(ArchUnitNETTests.Fluent.PlantUml, PlantUml)
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Fluent, Fluent)  {
Container(ArchUnitNETTests.Fluent.Slices, Slices)
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Boundary(Fluent, Fluent)  {
Boundary(Syntax, Syntax)  {
Container(ArchUnitNETTests.Fluent.Syntax.Elements, Elements)
}
}
}

Boundary(ArchUnitNETTests, ArchUnitNETTests)  {
Container(ArchUnitNETTests.Loader, Loader)
}

ArchUnitNETTests.Dependencies --> Domain
ArchUnitNETTests.Domain.Dependencies.Attributes --|> ArchUnitNETTests.Domain.Dependencies.Members
Domain -> ArchUnitNETTests.Dependencies
ArchUnitNETTests.Domain.Extensions --> Dependencies
Domain -> ArchUnitNETTests.Loader
Fluent ..> Domain
Fluent -> ArchUnitNETTests.AssemblyTestHelper
ArchUnitNETTests.Loader --> Domain
ArchUnitNETTests.Loader --> Fluent
@enduml
