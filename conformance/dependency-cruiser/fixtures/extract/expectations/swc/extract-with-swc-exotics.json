    "expected": []
  },
  {
    "id": "test/extract/swc/extract-with-swc-exotics.spec.mjs#2",
    "title": "[U] ast-extractors/extract-swc - exotics detects dependencies declared with one function names passed as exoticRequireStrings",
    "call": 1,
    "surface": "walk-swc",
    "cwd": ".",
    "input": {
      "parser": "swc",
      "source": "const want = need = require; const yo = want('./required-with-want'); const nope = need('./required-with-need');",
      "extension": null,
      "exoticRequireStrings": [
        "want"
      ]
    },
    "expected": [
      {
        "dynamic": false,
        "module": "./required-with-want",
        "moduleSystem": "cjs",
        "dependencyTypes": [
          "exotic-require"
        ],
        "exoticallyRequired": true,
        "exoticRequire": "want"
      }
    ]
  },
  {
    "id": "test/extract/swc/extract-with-swc-exotics.spec.mjs#3",
    "title": "[U] ast-extractors/extract-swc - exotics detects dependencies declared with member expression passed as exoticRequireStrings",
    "call": 1,
    "surface": "walk-swc",
    "cwd": ".",
    "input": {
      "parser": "swc",
      "source": "const yo = window.require('./required-with-window-require')",
      "extension": null,
      "exoticRequireStrings": [
        "window.require"
      ]
    },
    "expected": [
      {
        "dynamic": false,
        "module": "./required-with-window-require",
        "moduleSystem": "cjs",
        "exoticallyRequired": true,
        "exoticRequire": "window.require",
        "dependencyTypes": [
          "exotic-require"
        ]
      }
    ]
  },
  {
    "id": "test/extract/swc/extract-with-swc-exotics.spec.mjs#4",
