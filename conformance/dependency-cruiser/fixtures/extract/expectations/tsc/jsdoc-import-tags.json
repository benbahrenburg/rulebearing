    "id": "test/extract/tsc/jsdoc-import-tags.spec.mjs#1",
    "title": "[U] ast-extractors/extract-typescript - jsdoc @imports extracts jsdoc @import ('as' variant)",
    "call": 1,
    "surface": "walk-tsc",
    "cwd": ".",
    "input": {
      "parser": "tsc",
      "source": "/** @import * as fs from 'node:fs' */",
      "extension": null,
      "exoticRequireStrings": [],
      "detectJSDocImports": true,
      "detectProcessBuiltinModuleCalls": false
    },
    "expected": [
      {
        "dynamic": false,
        "module": "node:fs",
        "moduleSystem": "es6",
        "exoticallyRequired": false,
        "dependencyTypes": [
          "type-only",
          "import",
          "jsdoc",
          "jsdoc-import-tag"
        ]
      }
    ]
  },
