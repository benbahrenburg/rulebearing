diff --git a/.dependency-cruiser.mutations.cjs b/.dependency-cruiser.mutations.cjs
new file mode 100644
--- /dev/null
+++ b/.dependency-cruiser.mutations.cjs
@@ -0,0 +1,118 @@
+// Twelve rules, one per rule shape, each scoped to the folder its mutation lives in, so each
+// fires exactly on its mutation and nowhere else in dependency-cruiser's own tree. Applied by
+// Rulebearing's conformance gate 1 layer 5 (conformance/dependency-cruiser/mutations/README.md).
+module.exports = {
+  forbidden: [
+    {
+      name: "m01-forbidden",
+      comment: "Regular forbidden: a mutation module must not reach into the cli.",
+      severity: "error",
+      from: { path: "^src/mutation/01-forbidden/" },
+      to: { path: "^src/cli/" },
+    },
+    {
+      name: "m02-path-not",
+      comment: "pathNot: the only way out of the folder is to the utilities.",
+      severity: "error",
+      from: { path: "^src/mutation/02-path-not/" },
+      to: { pathNot: ["^src/mutation/02-path-not/", "^src/utl/"] },
+    },
+    {
+      name: "m03-fence",
+      comment: "A $1 fence: sibling folders stay independent of each other.",
+      severity: "error",
+      from: { path: "^src/mutation/03-fence/([^/]+)/" },
+      to: {
+        path: "^src/mutation/03-fence/",
+        pathNot: "^src/mutation/03-fence/$1/",
+      },
+    },
+    {
+      name: "m04-circular",
+      comment: "circular: no cycles.",
+      severity: "error",
+      from: { path: "^src/mutation/04-circular/" },
+      to: { circular: true },
+    },
+    {
+      name: "m05-orphan",
+      comment: "orphan: every module is used, or uses something.",
+      severity: "error",
+      from: { orphan: true, path: "^src/mutation/05-orphan/" },
+      to: {},
+    },
+    {
+      name: "m06-dependency-types-not",
+      comment: "dependencyTypesNot: local imports only.",
+      severity: "error",
+      from: { path: "^src/mutation/06-dependency-types-not/" },
+      to: { dependencyTypesNot: ["local"] },
+    },
+    {
+      name: "m07-reachable",
+      comment: "reachable, forbidden: entry must not reach forbidden, directly or not.",
+      severity: "error",
+      from: { path: "^src/mutation/07-reachable/entry[.]mjs$" },
+      to: {
+        path: "^src/mutation/07-reachable/forbidden[.]mjs$",
+        reachable: true,
+      },
+    },
+    {
+      name: "m09-dependents",
+      comment: "dependents: a shared module is shared by at least two.",
+      severity: "error",
+      from: { path: "^src/mutation/09-dependents/" },
+      module: {
+        path: "^src/mutation/09-dependents/shared[.]mjs$",
+        numberOfDependentsLessThan: 2,
+      },
+    },
+    {
+      name: "m11-via",
+      comment: "via: no cycle may run through the hub.",
+      severity: "error",
+      from: { path: "^src/mutation/11-via/", pathNot: "hub[.]mjs$" },
+      to: {
+        circular: true,
+        via: { path: "^src/mutation/11-via/hub[.]mjs$" },
+      },
+    },
+    {
+      name: "m12-could-not-resolve",
+      comment: "couldNotResolve: every import names a file.",
+      severity: "error",
+      from: { path: "^src/mutation/12-could-not-resolve/" },
+      to: { couldNotResolve: true },
+    },
+  ],
+  allowed: [
+    { from: { pathNot: "^src/mutation/10-allowed/" }, to: {} },
+    {
+      from: { path: "^src/mutation/10-allowed/" },
+      to: { path: "^src/mutation/10-allowed/" },
+    },
+  ],
+  allowedSeverity: "error",
+  required: [
+    {
+      name: "m08-required",
+      comment: "required: every module in the folder uses the bus.",
+      severity: "error",
+      module: { path: "^src/mutation/08-required/" },
+      to: { path: "^src/utl/bus[.]mjs$" },
+    },
+  ],
+  options: {
+    doNotFollow: { path: "node_modules" },
+    moduleSystems: ["es6", "cjs"],
+    tsPreCompilationDeps: true,
+    detectJSDocImports: true,
+    enhancedResolveOptions: {
+      exportsFields: ["exports"],
+      aliasFields: ["browser"],
+      conditionNames: ["import", "require"],
+      extensions: [".js", ".cjs", ".mjs", ".d.ts", ".d.mts"],
+    },
+  },
+};
