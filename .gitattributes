# Line endings are normalised in the repository and checked out as LF everywhere, so the
# byte-comparison conformance fixtures and the determinism test behave the same on Windows
# (docs/adr/0009-conformance-suites-as-specification.md, docs/adr/0024-test-quality-gates.md).
* text=auto eol=lf

*.sh            text eol=lf
*.rs            text eol=lf
*.md            text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf

# Binary fixtures: never normalised, never diffed as text.
*.dll           binary
*.pdb           binary
*.png           binary
*.ico           binary

# Generated or vendored: keep them out of language statistics and review diffs.
package-lock.json   linguist-generated=true
Cargo.lock          linguist-generated=true
schema/*.json       linguist-generated=true
docs/artifacts/**   linguist-documentation=true
conformance/**/fixtures/**  linguist-vendored=true

# Left out of the source archives GitHub serves, which is what a workflow's
# `uses: benbahrenburg/rulebearing@<ref>` downloads and unpacks: the vendored upstream fixtures
# hold a deliberately broken symlink (test/extract/__mocks__/invalid-symlink) that the runner
# cannot unpack, and nothing under them is needed to run the Action (plan 0001, Step 19).
conformance/**/fixtures/**  export-ignore
