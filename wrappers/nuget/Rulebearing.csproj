<!-- The `Rulebearing` dotnet tool: a launcher that runs the platform binary it carries under
     runtimes/<rid>/native/ for the six release targets of .github/workflows/release.yml.
     `dotnet tool install -g Rulebearing` puts `rulebearing` on the path. The 0.0.1 name
     reservation (docs/adr/0020-single-name-across-registries.md) was published from this path on
     2026-09-22; this is the package that replaces it. Staged and packed by wrappers/nuget/pack.sh
     (docs/release.md). Plan: docs/plans/pending/0002-wave-2-dotnet-python-element-rules.md, Step 14. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The oldest supported LTS; RollForward lets any later runtime run the tool. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>Rulebearing.Tool</AssemblyName>
    <RootNamespace>Rulebearing.Tool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rulebearing</ToolCommandName>
    <PackageId>Rulebearing</PackageId>
    <Description>Rulebearing as a dotnet tool: one architecture rule set for TypeScript, .NET and Python, deterministic guardrails an agent can check its own changes against. Carries the rulebearing binary for Linux x64 (glibc and musl) and arm64, macOS arm64 and x64, and Windows x64.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The directory of binaries to pack, laid out runtimes/<rid>/native/rulebearing[.exe];
         wrappers/nuget/pack.sh stages it from the release archives or a local build. -->
    <RulebearingRuntimes Condition="'$(RulebearingRuntimes)' == ''">$(MSBuildProjectDirectory)/runtimes/</RulebearingRuntimes>
    <RulebearingRuntimes>$([MSBuild]::EnsureTrailingSlash('$(RulebearingRuntimes)'))</RulebearingRuntimes>
    <!-- A release packs all six; a local smoke test packs the host's alone. -->
    <RulebearingRequireAllRuntimes Condition="'$(RulebearingRequireAllRuntimes)' == ''">true</RulebearingRequireAllRuntimes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Remove="tests/**" />
    <Content Include="$(RulebearingRuntimes)**/*"
             Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <InternalsVisibleTo Include="Rulebearing.Tool.Tests" />
  </ItemGroup>
  <ItemGroup>
    <RulebearingRid Include="linux-x64;linux-musl-x64;linux-arm64;osx-arm64;osx-x64;win-x64" />
  </ItemGroup>

  <!-- Refuse to pack a tool with no binary, or, for a release, without every target's. -->
  <Target Name="RulebearingCheckRuntimes" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <RulebearingMissing Include="@(RulebearingRid)" Condition="!Exists('$(RulebearingRuntimes)%(Identity)/native/rulebearing') and !Exists('$(RulebearingRuntimes)%(Identity)/native/rulebearing.exe')" />
      <RulebearingPresent Include="@(RulebearingRid)" Exclude="@(RulebearingMissing)" />
    </ItemGroup>
    <Error Condition="'@(RulebearingPresent)' == ''" Text="No rulebearing binary under $(RulebearingRuntimes)&lt;rid&gt;/native/. Fix: stage one with wrappers/nuget/pack.sh (docs/release.md)." />
    <Error Condition="'$(RulebearingRequireAllRuntimes)' == 'true' and '@(RulebearingMissing)' != ''" Text="The release package needs every target; missing: @(RulebearingMissing). Fix: stage all six archives, or pass -p:RulebearingRequireAllRuntimes=false for a local check." />
  </Target>
</Project>
