{
  "name": "rulebearing",
  "version": "0.1.0",
  "description": "One architecture rule set for TypeScript, .NET and Python: deterministic guardrails an agent can check its own changes against",
  "keywords": [
    "architecture",
    "dependency-cruiser",
    "dependencies",
    "boundaries",
    "lint",
    "vitest",
    "api"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benbahrenburg/rulebearing",
  "bugs": "https://github.com/benbahrenburg/rulebearing/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbahrenburg/rulebearing.git",
    "directory": "wrappers/npm"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rulebearing": "bin/rulebearing.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./config-utl/extract-babel-config": {
      "types": "./dist/api/config-utl/extract-babel-config.d.ts",
      "default": "./dist/api/config-utl/extract-babel-config.js"
    },
    "./config-utl/extract-depcruise-config": {
      "types": "./dist/api/config-utl/extract-depcruise-config.d.ts",
      "default": "./dist/api/config-utl/extract-depcruise-config.js"
    },
    "./config-utl/extract-ts-config": {
      "types": "./dist/api/config-utl/extract-ts-config.d.ts",
      "default": "./dist/api/config-utl/extract-ts-config.js"
    },
    "./config-utl/extract-webpack-resolve-config": {
      "types": "./dist/api/config-utl/extract-webpack-resolve-config.d.ts",
      "default": "./dist/api/config-utl/extract-webpack-resolve-config.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "default": "./dist/launcher.js"
    },
    "./package.json": "./package.json",
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    }
  },
  "files": [
    "bin/rulebearing.js",
    "dist/launcher.js",
    "dist/launcher.d.ts",
    "dist/platforms.js",
    "dist/platforms.d.ts",
    "dist/api/",
    "dist/vitest/",
    "types/dependency-cruiser/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p ../../adapters/vitest/tsconfig.build.json",
    "test": "vitest run --coverage",
    "stage": "npm run build && node scripts/stage.mjs"
  },
  "optionalDependencies": {
    "rulebearing-cli-linux-x64-gnu": "0.1.0",
    "rulebearing-cli-linux-x64-musl": "0.1.0",
    "rulebearing-cli-linux-arm64-gnu": "0.1.0",
    "rulebearing-cli-darwin-arm64": "0.1.0",
    "rulebearing-cli-darwin-x64": "0.1.0",
    "rulebearing-cli-win32-x64-msvc": "0.1.0"
  },
  "peerDependencies": {
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
