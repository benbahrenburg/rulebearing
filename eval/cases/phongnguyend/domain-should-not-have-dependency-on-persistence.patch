+using System;
+using ClassifiedAds.Persistence.Locks;
+
+namespace ClassifiedAds.Domain.Repositories;
+
+public static class LockTimeouts
+{
+    public static TimeSpan Of(LockOptions options)
+    {
+        return TimeSpan.FromSeconds(options is null ? 30 : options.TimeoutSeconds);
+    }
+}
