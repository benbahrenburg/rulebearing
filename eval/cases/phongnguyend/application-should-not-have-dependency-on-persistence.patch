+using ClassifiedAds.Persistence.Repositories;
+
+namespace ClassifiedAds.Application.Products.Queries;
+
+public static class ProductPaging
+{
+    public static int Skip(int page, ProductPagingOptions options)
+    {
+        var size = options is null ? 20 : options.PageSize;
+        return page <= 1 ? 0 : (page - 1) * size;
+    }
+}
