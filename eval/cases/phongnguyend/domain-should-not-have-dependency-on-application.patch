+using ClassifiedAds.Application.Common.DTOs;
+
+namespace ClassifiedAds.Domain.Repositories;
+
+public static class Paging
+{
+    public static int Skip(PageRequest request)
+    {
+        return request is null || request.Page <= 1 ? 0 : (request.Page - 1) * request.PageSize;
+    }
+}
