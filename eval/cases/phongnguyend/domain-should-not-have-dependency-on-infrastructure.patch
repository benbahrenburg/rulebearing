+using ClassifiedAds.Infrastructure.Storages;
+
+namespace ClassifiedAds.Domain.Entities;
+
+public static class FileEntryLocations
+{
+    public static string Describe(StorageLocation location)
+    {
+        return location is null ? string.Empty : location.Container + "/" + location.Path;
+    }
+}
