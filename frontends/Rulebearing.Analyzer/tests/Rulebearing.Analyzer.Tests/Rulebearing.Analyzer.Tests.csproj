<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of Rulebearing.Analyzer, held to the 70% line floor (docs/adr/0018-test-coverage-threshold.md).
    regex-compatibility.json is exported by rb-config's pattern tests
    (crates/rb-config/src/pattern.rs, the_cases_are_exported_for_the_analyzer).
    Plan: docs/plans/pending/0003-wave-3-operations-surface-inner-loop.md, Step 21.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Include>[Rulebearing.Analyzer]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageReference Include="YamlDotNet" Version="$(YamlDotNetVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" PrivateAssets="all" />
    <PackageReference Include="coverlet.msbuild" Version="$(CoverletVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rulebearing.Analyzer/Rulebearing.Analyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="regex-compatibility.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
