#!/usr/bin/env bash
# Runs the lint entry point and the test suite before a push.
# Install once: git config core.hooksPath .githooks
# Skip deliberately: git push --no-verify
# The hook is a convenience, not the gate; CI is the gate (docs/adr/0025-ci-and-supply-chain-hardening.md).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
# Git exports its repository variables (`git rev-parse --local-env-vars`) to a hook. From a
# linked worktree GIT_DIR is an absolute path to this repository, and a test that runs git in a
# scratch folder would act on this repository instead. Nothing below needs them.
while IFS= read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)
echo "pre-push: cargo lint"
cargo lint
echo "pre-push: cargo test --workspace --all-features"
cargo test --workspace --all-features --quiet
