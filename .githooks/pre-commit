#!/usr/bin/env bash
# Fast checks before a commit: formatting and documentation links.
# Install once: git config core.hooksPath .githooks
# Skip deliberately: git commit --no-verify
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
# Git exports its repository variables (`git rev-parse --local-env-vars`) to a hook. From a
# linked worktree GIT_DIR is an absolute path to this repository, and a test that runs git in a
# scratch folder would act on this repository instead. Nothing below needs them.
while IFS= read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)
cargo fmt --all -- --check
cargo xtask check-links
