/target
**/*.rs.bk
Cargo.lock.orig
/.graph/
/coverage/
/wrappers/npm/coverage/
/frontends/eslint-plugin-rulebearing/coverage/
/adapters/vitest/coverage/
# pytest-cov data (pyproject.toml, [tool.pytest.ini_options])
.coverage
.coverage.*
/lcov.info
# cargo-mutants working output (docs/adr/0024-test-quality-gates.md)
/mutants.out/
/mutants.out.old/
node_modules/
dist/
bin/
# The npm wrapper's launcher entry point is source, not build output (plan 0001, Step 19).
!/wrappers/npm/bin/
obj/
.venv/
__pycache__/
*.pyc
.DS_Store
/conformance/**/upstream/
/testbeds/checkouts/
# Vendored upstream test inputs keep their node_modules, dist and bin directories: they are data
# the conformance harness resolves against (conformance/dependency-cruiser/scripts/vendor.sh).
!/conformance/dependency-cruiser/fixtures/**
# The option fixtures' mini-repositories carry node_modules for the same reason (plan 0001, 1C).
!/crates/rb-extract-ts/tests/options/**
# The Python extractor's fixture carries a tiny fake .venv as data for the site index (plan 0002, 2B).
!/crates/rb-extract-python/tests/fixtures/**
/conformance/dependency-cruiser/fixtures/extract/test/extract/__mocks__/symlinked
/testbeds/out/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/target/
/fuzz/coverage/
/conformance/archunitnet/attribution/*.log
/wrappers/nuget/runtimes/
# grimp's import cache (import-linter)
.grimp_cache/
# The delivery plans and the exported design are kept local, not published (docs/adr/0039-plans-and-design-kept-local.md).
/docs/plans/
/docs/artifacts/
