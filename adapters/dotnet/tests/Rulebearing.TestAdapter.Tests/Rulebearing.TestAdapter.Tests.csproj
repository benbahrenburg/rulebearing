<!-- The core's tests: the junit message-equality proof against the built binary, the catalog port
     on the vectors of crates/rb-report/src/catalog.rs, and the runner's failure modes. Coverlet
     measures Rulebearing.TestAdapter alone at the 70% line floor (docs/adr/0018-test-coverage-threshold.md). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Include>[Rulebearing.TestAdapter]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rulebearing.TestAdapter/Rulebearing.TestAdapter.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitV2Version)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
