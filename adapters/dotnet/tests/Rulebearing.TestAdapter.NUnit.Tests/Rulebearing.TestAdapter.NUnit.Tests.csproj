<!-- NUnit fixture project: the fixture repository through [RulebearingTestCaseSource]. Coverlet
     measures Rulebearing.TestAdapter.NUnit alone at the 70% line floor (docs/adr/0018-test-coverage-threshold.md). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Include>[Rulebearing.TestAdapter.NUnit]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rulebearing.TestAdapter.NUnit/Rulebearing.TestAdapter.NUnit.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="NUnit" Version="$(NUnitVersion)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(NUnitAdapterVersion)" />
  </ItemGroup>
</Project>
