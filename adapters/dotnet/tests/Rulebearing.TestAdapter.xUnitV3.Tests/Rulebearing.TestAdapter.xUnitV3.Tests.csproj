<!-- xUnit v3 fixture project: the fixture repository through [RulebearingRules]. Coverlet measures
     Rulebearing.TestAdapter.xUnitV3 alone at the 70% line floor (docs/adr/0018-test-coverage-threshold.md). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Rulebearing.TestAdapter.xUnitV3]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rulebearing.TestAdapter.xUnitV3/Rulebearing.TestAdapter.xUnitV3.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
