<!--
  The Rulebearing.TestAdapter packages and their fixture test projects.
  Imports the root Directory.Build.props (analyzers, warnings as errors, the coverlet 70% line
  floor of docs/adr/0018-test-coverage-threshold.md) and the shared package metadata and version
  of eng/Rulebearing.Packages.props. The framework versions are pinned here once, so every package
  and its fixture project agree. Plan: docs/plans/pending/0002-wave-2-dotnet-python-element-rules.md,
  Step 14 (2H). Conventions: CLAUDE.md, C# conventions.
-->
<Project>
  <!-- A project named *.Tests is a test project. Set before the root props are imported, so their
       coverlet block (CollectCoverage, Threshold 70, line) applies to it. -->
  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
  <Import Project="$(MSBuildThisFileDirectory)../../eng/Rulebearing.Packages.props" />

  <PropertyGroup>
    <!-- The packages target the oldest supported LTS so a net8.0 test project can use them. -->
    <RulebearingLibraryFramework>net8.0</RulebearingLibraryFramework>
    <XunitV2Version>2.9.3</XunitV2Version>
    <XunitV3Version>3.2.2</XunitV3Version>
    <XunitRunnerVersion>3.1.5</XunitRunnerVersion>
    <NUnitVersion>4.6.1</NUnitVersion>
    <NUnitAdapterVersion>6.3.0</NUnitAdapterVersion>
    <MSTestV2Version>2.2.10</MSTestV2Version>
    <MSTestV4Version>4.4.1</MSTestV4Version>
    <TUnitVersion>1.69.0</TUnitVersion>
    <TestSdkVersion>18.10.1</TestSdkVersion>
    <CoverletVersion>10.0.1</CoverletVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <TargetFramework>$(RulebearingLibraryFramework)</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <!-- The fixture repository the fixture projects cruise: one passing rule, one failing rule. -->
    <RulebearingFixture>$(MSBuildThisFileDirectory)tests/fixture/</RulebearingFixture>
    <!-- Coverage reports land under the ignored target/ tree, one directory per project. -->
    <CoverletOutput>$(MSBuildThisFileDirectory)../../target/coverage/dotnet/$(MSBuildProjectName)/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.msbuild" Version="$(CoverletVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Compile Include="$(MSBuildThisFileDirectory)tests/Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
